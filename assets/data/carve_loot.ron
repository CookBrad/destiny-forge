// Per-species carve loot tables.
// guaranteed: always granted.
// bonus: named Common / Uncommon / Rare parts.
// Each carve draws `bonus_rolls` extra parts by rarity_weights (Rare weight is set-skill scalable).
[
    (
        target: Pack(Slime),
        guaranteed: [
            (SlimeGel, 2),
        ],
        bonus: [
            (material: SlimeGel, amount: 2, rarity: Common),
            (material: SlimeCore, amount: 1, rarity: Uncommon),
            (material: IronScrap, amount: 1, rarity: Uncommon),
            (material: SlimeCore, amount: 1, rarity: Rare),
        ],
        rarity_weights: (common: 70, uncommon: 25, rare: 5),
        bonus_rolls: 2,
    ),
    (
